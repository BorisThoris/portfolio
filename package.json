    "capture": "node scripts/capture-projects.mjs",
    "images:walk": "node scripts/capture-projects.mjs --state both",
    "images:refresh": "node scripts/capture-projects.mjs --state both",
    "images:stable": "node scripts/capture-projects.mjs --state stable",
    "images:latest": "node scripts/capture-projects.mjs --state latest",
    "images:check": "node scripts/capture-projects.mjs --check",
    "images:routes": "node scripts/capture-projects.mjs --list",
    "repos:analyze": "node scripts/analyze-repos.mjs",
    "projects:build": "node scripts/build-projects.mjs",
    "projects:status": "node scripts/project-status.mjs",
    "projects:dev": "node scripts/start-live-projects.mjs",
    "dev:builds": "node scripts/serve-projects.mjs --builds",
