{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-previews.mjs",
    "prebuild": "node scripts/build-previews.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-pages.mjs",
    "preview": "vite preview",
