    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "~5.8.3"
